// prisma/schema.prisma

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "linux-musl-openssl-3.0.x"]
}

model Book {
  id              Int       @id @default(autoincrement())
  title           String
  author          String?
  googleBooksId   String?   @unique @map("google_books_id")
  coverUrl        String?   @map("cover_url")
  genres          String?   // JSON array stored as string for SQLite
  publicationYear Int?      @map("publication_year")
  description     String?
  isbn            String?
  pageCount       Int?      @map("page_count")
  goodreadsUrl    String?   @map("goodreads_url")
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")
  reviews         Review[]
  collectionWorks CollectionWork[]

  @@map("books")
}

model Review {
  id                  Int       @id @default(autoincrement())
  book                Book?     @relation(fields: [bookId], references: [id], onDelete: Cascade)
  bookId              Int?      @map("book_id")
  telegramUserId      BigInt    @map("telegram_user_id")
  telegramUsername    String?   @map("telegram_username")
  telegramDisplayName String?   @map("telegram_display_name")
  reviewText          String    @map("review_text")
  sentiment           String?   // 'positive', 'negative', 'neutral'
  messageId           BigInt?   @map("message_id")
  chatId              BigInt?   @map("chat_id")
  reviewedAt          DateTime  @map("reviewed_at")
  createdAt           DateTime  @default(now()) @map("created_at")

  @@index([telegramUserId, reviewedAt])
  @@index([bookId])
  @@map("reviews")
}

model Subscription {
  id             Int      @id @default(autoincrement())
  telegramUserId BigInt   @unique @map("telegram_user_id")
  isActive       Boolean  @default(true) @map("is_active")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  @@map("subscriptions")
}

model BookCollection {
  slug             String            @id
  tileTitle        String            @map("tile_title")
  title            String
  description      String
  color            String            @default("#e3e8ea")
  intent           String            @default("recommendations")
  sourceId         String?           @map("source_id")
  sourceUrl        String?           @map("source_url")
  sourceTitle      String?           @map("source_title")
  sourceSnapshotAt DateTime?         @map("source_snapshot_at")
  sortOrder        Int               @default(0) @map("sort_order")
  entries          CollectionEntry[]
  createdAt        DateTime          @default(now()) @map("created_at")
  updatedAt        DateTime          @updatedAt @map("updated_at")

  @@index([sortOrder])
  @@map("book_collections")
}

model CollectionWork {
  id             String            @id
  bookId         Int?              @map("book_id")
  book           Book?             @relation(fields: [bookId], references: [id], onDelete: SetNull)
  title          String
  author         String
  isbn           String
  coverUrl       String            @map("cover_url")
  goodreadsUrl   String            @map("goodreads_url")
  titleAliases   String            @default("[]") @map("title_aliases")
  authorAliases  String            @default("[]") @map("author_aliases")
  catalogAliases String            @default("[]") @map("catalog_aliases")
  entries        CollectionEntry[]
  createdAt      DateTime          @default(now()) @map("created_at")
  updatedAt      DateTime          @updatedAt @map("updated_at")

  @@index([bookId])
  @@map("collection_works")
}

model CollectionEntry {
  collectionSlug String         @map("collection_slug")
  collection     BookCollection @relation(fields: [collectionSlug], references: [slug], onDelete: Cascade)
  workId         String         @map("work_id")
  work           CollectionWork @relation(fields: [workId], references: [id], onDelete: Cascade)
  rank           Int
  mentions       Int            @default(0)
  allMentions    Int            @default(0) @map("all_mentions")
  votes          Int            @default(0)
  weightedVotes  Float          @default(0) @map("weighted_votes")
  score          Float          @default(0)

  @@id([collectionSlug, workId])
  @@unique([collectionSlug, rank])
  @@index([workId])
  @@map("collection_entries")
}
